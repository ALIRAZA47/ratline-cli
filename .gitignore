/bin/
/dist/
coverage.out
*.test
*.out

# Note: files under internal/*/testdata/fuzz/ are deliberately committed. Each one
# is an input that used to break a validator, so it is a regression test.

.DS_Store
*.swp

# Documentation site
/docs/web/node_modules/
/docs/web/dist/

# Copied from packaging/install.sh at build time; the source is there, not here.
docs/web/public/install.sh

# Copied from docs/topics at build time; the source is there, not here.
docs/web/src/generated/

# Agent worktrees, which are git repositories of their own.
.claude/worktrees/

# The panel's interface
/panel/web/node_modules/
# Built by `npm --prefix panel/web run build` straight into the Go package that
# embeds it. The source is in panel/web; a fresh clone embeds the placeholder page
# beside it instead, so `go build ./...` works without Node.
/internal/panel/web/dist/*
!/internal/panel/web/dist/.gitkeep
# tsc -b's incremental cache, not source.
*.tsbuildinfo

# Copied from packaging/panel-install.sh at build time; the source is there, not here.
docs/web/public/panel.sh
