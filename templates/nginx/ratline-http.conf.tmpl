# managed-by: ratline
#
# Included from the http block. Holds the map that proxy-params.conf needs, and
# the compression settings, which are http-level rather than per-server.

# A plain request must send "close", not a stray "upgrade": some frameworks
# reject an Upgrade header they did not ask for.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

{{- range .Compression }}
{{ . }}
{{- end }}
{{- if .Skipped }}

# Left to nginx.conf, which already sets these inside its http block: {{ .Skipped }}.
# nginx treats a repeated directive in one context as an error rather than an
# override, and this file is included into that same block.
{{- end }}
